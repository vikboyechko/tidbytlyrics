# Spotify developer app (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"
SPOTIFY_REFRESH_TOKEN="your-spotify-refresh-token"

# Tidbyt mobile app > device settings > Get API key
TIDBYT_DEVICE_ID="your-tidbyt-device-id"
TIDBYT_API_TOKEN="your-tidbyt-api-token"

# Lyrics timing: ms before a line is sung that its push completes.
# Lines appear late -> raise it. Lines appear early -> lower it.
DISPLAY_LEAD_MS="-300"
